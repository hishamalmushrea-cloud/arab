{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arab.example/schema/v1/alias.schema.json",
  "title": "Alias",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "entity_id", "name", "language", "script", "kind", "status", "source_id", "source_locator", "valid_from", "valid_to"],
  "properties": {
    "id": {"type": "string", "pattern": "^ALS-[A-Z0-9-]+$"},
    "schema_version": {"const": "1.0.0"},
    "entity_id": {"type": "string", "pattern": "^ENT-[A-Z]{2}-[A-Z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "script": {"enum": ["Arab", "Latn", "other"]},
    "kind": {"enum": ["alternative", "english", "transliteration", "local", "historical", "former", "abbreviation", "official_variant"]},
    "status": {"enum": ["current", "historical", "disputed", "uncertain"]},
    "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
    "source_locator": {"type": "string", "minLength": 1},
    "valid_from": {"type": ["string", "null"], "format": "date"},
    "valid_to": {"type": ["string", "null"], "format": "date"}
  }
}
