{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arab.example/schema/v1/claim.schema.json",
  "title": "Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "subject_id", "predicate", "value", "unit", "status", "observed_at", "valid_from", "valid_to", "source_id", "second_source_id", "source_locator", "sensitivity", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^CLM-[A-Z0-9-]+$"},
    "schema_version": {"const": "1.0.0"},
    "subject_id": {"type": "string", "pattern": "^ENT-[A-Z]{2}-[A-Z0-9-]+$"},
    "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "data"],
      "properties": {
        "type": {"enum": ["string", "integer", "number", "boolean", "date", "json"]},
        "data": {}
      }
    },
    "unit": {"type": ["string", "null"]},
    "status": {"enum": ["verified", "reported", "disputed", "historical", "uncertain", "retracted"]},
    "observed_at": {"type": ["string", "null"], "format": "date"},
    "valid_from": {"type": ["string", "null"], "format": "date"},
    "valid_to": {"type": ["string", "null"], "format": "date"},
    "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
    "second_source_id": {"type": ["string", "null"], "pattern": "^SRC-[A-Z0-9-]+$"},
    "source_locator": {"type": "string", "minLength": 1},
    "sensitivity": {"enum": ["ordinary", "sensitive"]},
    "notes": {"type": ["string", "null"]}
  }
}
