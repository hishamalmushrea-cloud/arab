{
  "$id": "https://arab.example/schema/v1/claim.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "classification": {
      "enum": [
        "official",
        "popular",
        "shared",
        "regional",
        "historical",
        "disputed",
        "national",
        "local",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "id": {
      "pattern": "^CLM-[A-Z0-9-]+$",
      "type": "string"
    },
    "lexical_context": {
      "additionalProperties": false,
      "properties": {
        "dialect": {
          "type": [
            "string",
            "null"
          ]
        },
        "form": {
          "minLength": 1,
          "type": "string"
        },
        "ipa": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "minLength": 2,
          "type": "string"
        },
        "meaning": {
          "minLength": 1,
          "type": "string"
        },
        "place_id": {
          "pattern": "^ENT-[A-Z]{2}-[A-Z0-9-]+$",
          "type": "string"
        },
        "register": {
          "minLength": 1,
          "type": "string"
        },
        "speaker_or_study": {
          "type": [
            "string",
            "null"
          ]
        },
        "study_date": {
          "format": "date",
          "type": [
            "string",
            "null"
          ]
        },
        "variety": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "form",
        "meaning",
        "place_id",
        "language",
        "dialect",
        "variety",
        "register",
        "study_date",
        "speaker_or_study",
        "ipa"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "format": "date",
      "type": [
        "string",
        "null"
      ]
    },
    "predicate": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "published": {
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "second_source_id": {
      "pattern": "^SRC-[A-Z0-9-]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "second_source_locator": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "sensitivity": {
      "enum": [
        "ordinary",
        "sensitive"
      ]
    },
    "source_id": {
      "pattern": "^SRC-[A-Z0-9-]+$",
      "type": "string"
    },
    "source_locator": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "reported",
        "disputed",
        "historical",
        "uncertain",
        "retracted"
      ]
    },
    "subject_id": {
      "pattern": "^ENT-[A-Z]{2}-[A-Z0-9-]+$",
      "type": "string"
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_from": {
      "format": "date",
      "type": [
        "string",
        "null"
      ]
    },
    "valid_to": {
      "format": "date",
      "type": [
        "string",
        "null"
      ]
    },
    "value": {
      "additionalProperties": false,
      "properties": {
        "data": {},
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "date",
            "json"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ],
      "type": "object"
    },
    "verification_status": {
      "enum": [
        "verified",
        "source_verified",
        "partial",
        "ambiguous",
        "needs_review"
      ]
    }
  },
  "required": [
    "id",
    "schema_version",
    "subject_id",
    "predicate",
    "value",
    "unit",
    "status",
    "observed_at",
    "valid_from",
    "valid_to",
    "source_id",
    "second_source_id",
    "source_locator",
    "sensitivity",
    "notes",
    "verification_status",
    "confidence",
    "classification",
    "published",
    "second_source_locator",
    "lexical_context"
  ],
  "title": "Claim",
  "type": "object"
}
