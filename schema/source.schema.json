{
  "$id": "https://arab.example/schema/v2/source.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive_url": {
      "format": "uri",
      "type": [
        "string",
        "null"
      ]
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "checksum": {
      "type": [
        "string",
        "null"
      ]
    },
    "country_codes": {
      "items": {
        "pattern": "^[A-Z]{2}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^SRC-[A-Z0-9-]+$",
      "type": "string"
    },
    "language": {
      "minLength": 2,
      "type": "string"
    },
    "license": {
      "minLength": 1,
      "type": "string"
    },
    "locator": {
      "minLength": 1,
      "type": "string"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "organization": {
      "type": [
        "string",
        "null"
      ]
    },
    "publication_date": {
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
      "type": [
        "string",
        "null"
      ]
    },
    "publisher": {
      "minLength": 1,
      "type": "string"
    },
    "quality_tier": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "retrieved_at": {
      "format": "date",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "source_type": {
      "enum": [
        "official_dataset",
        "official_register",
        "law",
        "census",
        "official_report",
        "standard",
        "academic",
        "archive",
        "project_audit",
        "institutional_dataset",
        "institutional_page",
        "local_book",
        "local_press",
        "local_website",
        "blog",
        "forum",
        "oral_testimony",
        "map",
        "heritage_book"
      ]
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "url": {
      "format": "uri",
      "pattern": "^https?://",
      "type": "string"
    }
  },
  "required": [
    "id",
    "schema_version",
    "title",
    "publisher",
    "source_type",
    "url",
    "archive_url",
    "publication_date",
    "retrieved_at",
    "license",
    "language",
    "country_codes",
    "locator",
    "checksum",
    "quality_tier",
    "notes"
  ],
  "title": "Source",
  "type": "object"
}
