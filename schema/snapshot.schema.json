{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arab.example/schema/v1/snapshot.schema.json",
  "title": "Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "title", "captured_at", "source_id", "scope", "method", "checksum", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^SNP-[A-Z0-9-]+$"},
    "schema_version": {"const": "1.0.0"},
    "title": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date"},
    "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
    "scope": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "checksum": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
