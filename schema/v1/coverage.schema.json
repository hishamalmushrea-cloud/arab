{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arab.example/schema/v1/coverage.schema.json",
  "title": "Coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "country_code", "layer", "snapshot_id", "denominator_id", "source_id", "matched", "unmatched", "excluded", "missing", "coverage_percent", "complete", "missing_reason", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^COV-[A-Z0-9-]+$"},
    "schema_version": {"const": "1.0.0"},
    "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "layer": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "snapshot_id": {"type": "string", "pattern": "^SNP-[A-Z0-9-]+$"},
    "denominator_id": {"type": "string", "pattern": "^DEN-[A-Z0-9-]+$"},
    "source_id": {"type": ["string", "null"], "pattern": "^SRC-[A-Z0-9-]+$"},
    "matched": {"type": "integer", "minimum": 0},
    "unmatched": {"type": "integer", "minimum": 0},
    "excluded": {"type": "integer", "minimum": 0},
    "missing": {"type": ["integer", "null"], "minimum": 0},
    "coverage_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "complete": {"type": "boolean"},
    "missing_reason": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
