{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arab.example/schema/v1/source.schema.json",
  "title": "Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "title", "publisher", "source_type", "url", "archive_url", "publication_date", "retrieved_at", "license", "language", "country_codes", "locator", "checksum", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
    "schema_version": {"const": "1.0.0"},
    "title": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["official_dataset", "official_register", "law", "census", "official_report", "standard", "academic", "archive", "project_audit"]},
    "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "archive_url": {"type": ["string", "null"], "format": "uri"},
    "publication_date": {"type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
    "retrieved_at": {"type": "string", "format": "date"},
    "license": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "country_codes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2}$"}, "uniqueItems": true},
    "locator": {"type": "string", "minLength": 1},
    "checksum": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
