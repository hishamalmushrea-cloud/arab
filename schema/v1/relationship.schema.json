{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arab.example/schema/v1/relationship.schema.json",
  "title": "Relationship",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "child_id", "parent_id", "relationship_type", "status", "valid_from", "valid_to", "source_id", "source_locator", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^REL-[A-Z0-9-]+$"},
    "schema_version": {"const": "1.0.0"},
    "child_id": {"type": "string", "pattern": "^ENT-[A-Z]{2}-[A-Z0-9-]+$"},
    "parent_id": {"type": "string", "pattern": "^ENT-[A-Z]{2}-[A-Z0-9-]+$"},
    "relationship_type": {"enum": ["administrative_parent", "located_in", "capital_of", "seat_of", "historic_successor", "claimed_by"]},
    "status": {"enum": ["current", "historical", "disputed", "de_facto", "claimed", "proposed", "transitional", "uncertain"]},
    "valid_from": {"type": ["string", "null"], "format": "date"},
    "valid_to": {"type": ["string", "null"], "format": "date"},
    "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
    "source_locator": {"type": "string", "minLength": 1},
    "notes": {"type": ["string", "null"]}
  }
}
