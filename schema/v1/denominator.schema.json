{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arab.example/schema/v1/denominator.schema.json",
  "title": "Denominator",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "country_code", "layer", "definition", "value", "as_of", "status", "source_id", "source_locator", "license", "missing_reason", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^DEN-[A-Z0-9-]+$"},
    "schema_version": {"const": "1.0.0"},
    "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "layer": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "definition": {"type": "string", "minLength": 1},
    "value": {"type": ["integer", "null"], "minimum": 0},
    "as_of": {"type": ["string", "null"], "format": "date"},
    "status": {"enum": ["official", "conflicted", "unavailable", "provisional"]},
    "source_id": {"type": ["string", "null"], "pattern": "^SRC-[A-Z0-9-]+$"},
    "source_locator": {"type": ["string", "null"]},
    "license": {"type": ["string", "null"]},
    "missing_reason": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
